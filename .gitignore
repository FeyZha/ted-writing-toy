# Publish only the final app, its tests, and the current material rules.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/启动练习.cmd
!/mvp/
!/产品设计/
/产品设计/*
!/产品设计/13-素材处理与练习接入规则.md
/mvp/*
!/mvp/.gitignore
!/mvp/package.json
!/mvp/package-lock.json
!/mvp/index.html
!/mvp/tsconfig.json
!/mvp/vite.config.ts
!/mvp/src/
!/mvp/scripts/
!/mvp/tests/
!/mvp/public/
/mvp/public/*
!/mvp/public/favicon.svg
!/mvp/public/app-meta.json
**/.env
**/.env.*
**/*.pem
**/*.key
